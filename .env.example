# Copy this file to .env and fill in real values. .env is gitignored.

# --- Server ---
PORT=8080
HOST=0.0.0.0
# Design-review switch: set to "true" to reveal every monster's lore and
# power in the Bestiary regardless of what's actually been defeated.
# Leave unset for normal play.
BESTIARY=
# Dev-only monster sprite editor at /tool (paint pixels, trace a reference
# image, save straight into public/js/sprites.js). Set to "true" to enable.
# Leave unset in production -- it writes to source files on disk.
TOOLS=
# Cheat switch for testing: every click kills the current target outright,
# bypassing shields/hydra invuln/math gates. Set to "true" to enable.
GOD=
# Dev-only monster simulator at /monsters -- pick any monster from the
# full roster and fight it in an isolated test arena, independent of
# realm progress or your save. Set to "true" to enable.
MONSTERS=

# --- MariaDB (multi-user accounts, leaderboard) ---
# Leave unset to keep running guest-only -- guest progress saves entirely
# in the player's own browser (localStorage), never on the server.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=pixel-warren

# Admin page at /admin (and the /api/admin/* endpoints it uses) for
# deleting a user or resetting a forgotten password -- there's no
# self-service "forgot password" flow. Set to a strong, unique value to
# enable; leave unset to disable both entirely (they 404, same as
# TOOLS/MONSTERS above when off). Requires MariaDB to be configured too,
# since there's nothing to administer in guest-only mode.
ADMIN_PASSWORD=
